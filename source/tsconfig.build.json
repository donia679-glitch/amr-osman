{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "noEmit": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noCheck": true,
    "outDir": "apps/ipad/engine",
    "rootDir": "packages/engine/src",
    "types": []
  },
  "include": ["packages/engine/src/**/*.ts"]
}
